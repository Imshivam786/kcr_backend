# path where uploaded images are stored (relative to project root)
UPLOAD_DIR=uploads

# CORS origins (comma separated); include your Angular dev url
CORS_ORIGINS=http://localhost:4200

# whether to enable GPU for EasyOCR reader
MODEL_USE_GPU=false

DATABASE_USER=postgres
DATABASE_PASSWORD=user
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=kcr_db
